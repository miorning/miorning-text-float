{
  "manifest_version": 3,
  "name": "喵咛文本窗 · MIORNING",
  "version": "0.4.1",
  "description": "全网页浮动文本窗：拖动缩放、版本与图片引用；贴边图标设置，全局 Alt+K 开关。Enter 换行，Esc 确认。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "喵咛文本窗设置",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "control.js",
        "store.js",
        "shell.js",
        "references.js",
        "menus.js",
        "dock.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "icons/48.png",
        "icons/128.png"
      ]
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
